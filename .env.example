# --- Runtime app (server) env vars, set in the Aiven app config ---
MCP_AUTH_TOKEN=change-me-long-random-string      # python -c "import secrets; print(secrets.token_urlsafe(32))"
KAFKA_BOOTSTRAP_SERVERS=your-kafka-project.aivencloud.com:12345
KAFKA_TOPIC=table-lights
KAFKA_CA_CERT="-----BEGIN CERTIFICATE-----..."      # PEM contents, not a path
KAFKA_ACCESS_CERT="-----BEGIN CERTIFICATE-----..."
KAFKA_ACCESS_KEY="-----BEGIN PRIVATE KEY-----..."

# --- Pi (table_lights.py) env vars: certificate paths, not contents ---
# KAFKA_BOOTSTRAP_SERVERS and KAFKA_TOPIC as above
KAFKA_CA_FILE=/opt/table-lights/ca.pem
KAFKA_CERT_FILE=/opt/table-lights/service.cert
KAFKA_KEY_FILE=/opt/table-lights/service.key
LED_COUNT=200            # main matrix; LEDs past 200 (side panel) stay dark
MAX_BRIGHTNESS=200       # power-safety cap, 0-255
# Optional: picture orientation. Either flip by hand, or reuse the game's saved orientation.
# FLIP_X=1
# FLIP_Y=1
# TETRIS_ORIENT_FILE=/home/hugh/tetris_orientation.json
